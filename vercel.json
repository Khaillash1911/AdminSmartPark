{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "admin-web",
      "framework": "angular",
      "outputDirectory": "dist/admin-web/browser"
    },
    "parking": {
      "root": ".",
      "entrypoint": "services.parking.main:app",
      "functions": {
        "services/parking/main.py": {
          "maxDuration": 60,
          "includeFiles": "research/parking-analytics/**"
        }
      }
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-src https://smartpark-ai-web.firebaseapp.com; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://res.cloudinary.com; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.trycloudflare.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://smartpark-admin-nine.vercel.app"
        },
        {
          "key": "Vary",
          "value": "Origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/parking/:path*",
      "destination": { "service": "parking" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
