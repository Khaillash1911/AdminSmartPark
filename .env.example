# Browser origins allowed to call the local AI gateway (comma-separated).
ALLOWED_ORIGINS=https://your-project.vercel.app,http://localhost:4200

# Local-only service addresses.
AI_GATEWAY_PORT=8000
YOLO_INTERNAL_URL=http://127.0.0.1:5050
OCR_INTERNAL_URL=http://127.0.0.1:5002
AI_HEALTH_TIMEOUT_SECONDS=3
AI_INFERENCE_TIMEOUT_SECONDS=180
AI_MAX_IMAGE_BYTES=20971520

# Firestore document updated by the trusted local launcher.
AI_RUNTIME_CONFIG_PATH=system_config/ai_api
GOOGLE_APPLICATION_CREDENTIALS=/absolute/local/path/to/serviceAccountKey.json

# Existing Cloudinary configuration.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=your_cloud_name
