            },
            "rows": {
              "type": "array<ParkingRowState>",
              "required": true,
              "itemSchema": {
                "row": "string",
                "section": "string enum A|B|C",
                "capacity": "integer",
                "occupied": "integer",
                "available": "integer",
                "occupancyPercentage": "number",
                "status": "string enum LOW|MEDIUM|HIGH",
                "entries": "integer",
                "exits": "integer"
