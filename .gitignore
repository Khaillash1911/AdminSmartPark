# Virtual environments
.venv/
venv/
env/
.env
.env.*
!.env.example
# Cloudinary API key/secret are stored in this local file.
find_my_car_system/backend/.env

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Mac OS
.DS_Store

# Uploads directory
uploads/

# Generated detector outputs
detection/plate_crops/
detection/test_output/
detection/annotated_images/*_detected.jpg

# Local simulator database
backend/database/*.db
backend/database/*.db-*

# User specified ignores
admin-app/
plate_detector/
plate detector/
models/
# Find My Car requires this trained plate-detector model on a fresh device.
!find_my_car_system/backend/models/
!find_my_car_system/backend/models/best.pt

# Runtime OCR and upload artifacts (images are persisted in Cloudinary).
find_my_car_system/backend/static/car_images/
find_my_car_system/backend/static/plate_crops/
find_my_car_system/backend/static/results/

# Old segmentation weights; the detector now uses yolov8m-seg.pt.
detection/yolov8n-seg.pt

# Firebase Service Account Key
serviceAccountKey.json
